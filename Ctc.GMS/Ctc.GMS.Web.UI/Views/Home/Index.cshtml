@* ~/Views/Home/Index.cshtml - Public-Facing Homepage *@
@* Content sourced from GMS Public Portal Template_3.12.xlsx (approved copy) *@

@{
    ViewData["Title"] = "Student Teacher Stipend Program";
}

@* Welcome Section *@
<div class="content-section welcome-section">
    <div class="r4-card">
        <div class="r4-card-body">
            <h1 class="welcome-title">Welcome to the Student Teacher Stipend Program Online Application Portal!</h1>
            <p class="welcome-text">
                Through this portal, institutions of higher education (IHEs) and local education agencies (LEAs) will apply on behalf of  eligible student teachers for a $10,000 stipend to support them during the completion of 500 or more hours of clinical practice during their credential program.
            </p>
            <div class="r4-alert r4-alert-info mt-3 mb-0">
                <i class="mdi mdi-information-outline me-2"></i>
                <strong>Note:</strong> Because Proposition 98 funds are appropriated for this grant progam, only LEAs are eligible to receive grant funds from the Commission to distribute to eligible student teachers in their schools.  As such, student teachers do not apply directly for the Student Teacher Stipend.
            </div>
        </div>
    </div>
</div>

@* How the Application Process Works *@
<div class="content-section">
    <h2 class="section-title">How the application process works:</h2>
    <div class="process-grid">
        @* IHE Column *@
        <div class="process-card">
            <div class="process-card-icon">
                <i class="mdi mdi-school"></i>
            </div>
            <h3>Institution of Higher Education (IHE)</h3>
            <p>
                IHEs partner with LEAs to identify eligibile student teachers, coordinate clinical placements, and provide evidence of professional fitness review for stipend eligibility.
            </p>
            <p>
                IHEs begin the process by submitting a list of student teachers to appropriate LEAs via the IHE portal. IHEs may submit names of student teachers monthly.
            </p>
            <p>
                 IHEs will be responsible for reporting to the Commission candidate completion of required hours and credential program.
            </p>
        </div>

        @* LEA Column *@
        <div class="process-card">
            <div class="process-card-icon">
                <i class="mdi mdi-domain"></i>
            </div>
            <h3>Local Education Agency (LEA)</h3>
            <p>
                LEAs receive Prop 98 grant funds to provide stipends to student teachers placed within their schools for clinical practice.
            </p>
            <p>
                LEAs will review student teachers submitted by IHEs, confirm that they have begun student teaching with the LEA, and will submit the application for funding to the Commission.
            </p>
            <p>
                LEAs will sign a Grant Award Agreement (GAA) which will be updated montly if additional student teachers are added for the academic year.
            </p>
            <p>
                LEAs will pay the student teacher the $10,000 stipend.
            </p>
            <p>
                LEAs will be responsible for reporting to the Commission confirmation of stipend payment.
            </p>
        </div>

        @* Commission Staff Column *@
        <div class="process-card">
            <div class="process-card-icon">
                <i class="mdi mdi-shield-check"></i>
            </div>
            <h3>Commission Staff</h3>
            <p>
                Commision Grants and Fiscal teams review applications, process disbursements, and ensure compliance with Education Code 44400 - 44400.03 requirements.
            </p>
            <p>
                The Commission will receive up to 12 monthly applications (one per month) of student teachers from partipating LEAs.
            </p>
            <p>
                Once a monthly submission is made, the Commission will review the application, create or update the GAA, and process payment to the LEA.
            </p>
            <p>
                When student teachers complete their assigments, the Commission will require IHEs and LEAs to submit reports.
            </p>
        </div>
    </div>
</div>

@* Submission Checklists *@
<div class="content-section">
    <div class="checklist-grid">
        @* IHE Checklist *@
        <div class="r4-card">
            <div class="r4-card-header">
                <h2><i class="mdi mdi-clipboard-check-outline"></i> IHE Student Teacher  Submission Checklist:</h2>
            </div>
            <div class="r4-card-body">
                <ul class="checklist">
                    <li>Name of student teacher</li>
                    <li>Confirmation of professional fitness (document number for a Certificate of Clearance (COC), substitute credential, etc.)</li>
                    <li><em>Note: per authorizing legislation, student teachers must have professional fitness review to receive a stipend. Student teacher candidate will not move to the LEA until professional fitness is confirmed.</em></li>
                    <li>Credential(s) student teacher is seeking</li>
                    <li>County, district, school site(s) of clinical placement(s)</li>
                    <li>LEA partner(s) contact information</li>
                </ul>
            </div>
        </div>

        @* LEA Checklist *@
        <div class="r4-card">
            <div class="r4-card-header">
                <h2><i class="mdi mdi-clipboard-check-outline"></i> LEA Application  Submission Checklist:</h2>
            </div>
            <div class="r4-card-body">
                <ul class="checklist">
                    <li>LEA point of pontact</li>
                    <li>Grant Award Agreement (GAA)  authorized signer information</li>
                    <li>Fiscal Agent Information</li>
                    <li>Superintendent Information</li>
                    <li>Information about how the student teacher will be paid.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@* CTA Buttons *@
<div class="content-section">
    <div class="cta-grid">
        <a href="@Url.Action("Dashboard", "IHEPortal")" class="btn-cta">
            <i class="mdi mdi-school"></i> CLICK HERE TO BEGIN
