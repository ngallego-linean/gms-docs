    }

    AUDIT_LOG {
        bigint Id PK
        varchar(100) EntityType
        int EntityId
        varchar(50) Action
        varchar(max) OldValueJson
        varchar(max) NewValueJson
        int AccountId FK
        varchar(45) IpAddress
        varchar(500) UserAgent
        datetime CreatedOn
        int CreatedByAccountId
        datetime LastUpdatedOn
        int LastUpdatedByAccountId
