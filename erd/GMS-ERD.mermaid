        varchar(500) Description
        int DisplayOrder
    }

    GRANT_CYCLE {
        int Id PK
        int GrantProgramId FK
        int FiscalYearId FK
        int StatusId FK
        int WorkflowTypeId FK
        int BatchStrategyId FK
        varchar(100) Name
        decimal AppropriatedAmount
        decimal EncumberedAmount
        decimal DisbursedAmount
        decimal DefaultCandidateAwardAmount
        decimal MinimumCandidateAwardAmount
        decimal MaximumCandidateAwardAmount
        datetime ApplicationPeriodBeginsOn
        datetime ApplicationPeriodEndsOn
        datetime BeginsOn
        datetime EndsOn
    }

    ORGANIZATION_TYPE_SVT {
        int Id PK
        varchar(100) Name
        varchar(500) Description
