    GRANT_PROGRAM_STATUS_SVT {
        int Id PK
        varchar(100) Name
        varchar(500) Description
        int DisplayOrder
    }

    GRANT_PROGRAM {
        int Id PK
        int StatusId FK
        varchar(50) Code UK
        varchar(100) Name
        varchar(500) Description
        int MinimumPreparationHoursRequiredForEligibility
        int StudentTeachingClinicalPracticeHoursThreshold
        varchar(max) EligibleCredentialAreasJson
        varchar(max) RequiredDocumentsJson
    }

    FISCAL_YEAR {
        int Id PK
        varchar(20) Name UK
        datetime BeginsOn
        datetime EndsOn
    }

    GRANT_CYCLE_STATUS_SVT {
        int Id PK
        varchar(100) Name
        varchar(500) Description
        int DisplayOrder
    }

    GRANT_CYCLE_WORKFLOW_TYPE_SVT {
        int Id PK
        varchar(100) Name
        varchar(500) Description
